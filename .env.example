# ==============================================================================
# META DEVELOPER AGENT v5.0.0 — CONFIGURATION INFRASTRUCTURE (.env.example)
# ==============================================================================
# Note : Les clés API OpenRouter et les modèles LLM sont gérés 100% dynamiquement
# depuis l'interface web (Modale Paramètres ⚙️) et enregistrés dans SQLite WAL.

# 1. Port d'accès web de l'application (Défaut : 8000 -> http://localhost:8000)
APP_PORT=8000

# 2. Allocation dynamique des ressources Docker (S'adapte à votre PC)
DOCKER_MEM_LIMIT=4g
DOCKER_CPUS=4.0

# 3. Emplacements de stockage persistant
META_DATA_DIR=data
META_OUTPUT_DIR=output_projects


